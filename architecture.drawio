<mxfile host="Electron" agent="draw.io"><diagram name="RAG по регламентам" id="rag"><mxGraphModel dx="1600" dy="705" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="705" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rag-2" value="RAG-пайплайн по регламентам: подготовка базы знаний и обработка запроса" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=21;fontColor=#202124;fontStyle=1;rotation=0;" vertex="1" parent="1"><mxGeometry x="30" y="26" width="714" height="24" as="geometry"/></mxCell><mxCell id="rag-3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00695C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="46" height="270" as="geometry"/></mxCell><mxCell id="rag-4" value="ПОДГОТОВКА&lt;br&gt;(офлайн)" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Calibri;fontSize=14;fontColor=white;fontStyle=1;rotation=-90;" vertex="1" parent="1"><mxGeometry x="15" y="199" width="75" height="32" as="geometry"/></mxCell><mxCell id="rag-5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3949AB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="46" height="240" as="geometry"/></mxCell><mxCell id="rag-6" value="ЗАПРОС&lt;br&gt;(онлайн)" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Calibri;fontSize=14;fontColor=white;fontStyle=1;rotation=-90;" vertex="1" parent="1"><mxGeometry x="22" y="504" width="62" height="32" as="geometry"/></mxCell><mxCell id="rag-7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B0BEC5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="374" width="1540" height="1" as="geometry"/></mxCell><mxCell id="rag-8" value="Пунктир: то, что в стенде не запускается (LLM), и обратная связь от оценки к настройке поиска." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=13;fontColor=#546E7A;fontStyle=0;rotation=0;" vertex="1" parent="1"><mxGeometry x="30" y="664" width="593" height="15" as="geometry"/></mxCell><mxCell id="rag-src" value="&lt;b&gt;Регламенты&lt;/b&gt;&lt;br&gt;PDF и DOCX&lt;br&gt;из папки /docs&lt;br&gt;(в проде: СЭД)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#546E7A;strokeColor=#546E7A;fontColor=white;fontFamily=Calibri;fontSize=14;" vertex="1" parent="1"><mxGeometry x="105" y="145" width="200" height="130" as="geometry"/></mxCell><mxCell id="rag-ing" value="&lt;b&gt;1. &lt;/b&gt;&lt;b&gt;Ingestion&lt;/b&gt;&lt;br&gt;pypdf, python-docx&lt;br&gt;очистка колонтитулов&lt;br&gt;sha256: только изменённые" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#00796B;strokeColor=#00796B;fontColor=white;fontFamily=Calibri;fontSize=14;" vertex="1" parent="1"><mxGeometry x="345" y="145" width="205" height="130" as="geometry"/></mxCell><mxCell id="rag-chk" value="&lt;b&gt;2. &lt;/b&gt;&lt;b&gt;Chunking&lt;/b&gt;&lt;br&gt;по разделам «N. Заголовок»&lt;br&gt;до 400 символов,&lt;br&gt;перекрытие 1 предложение" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#00796B;strokeColor=#00796B;fontColor=white;fontFamily=Calibri;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590" y="145" width="205" height="130" as="geometry"/></mxCell><mxCell id="rag-emb" value="&lt;b&gt;3. &lt;/b&gt;&lt;b&gt;Embedding&lt;/b&gt;&lt;br&gt;fastembed, ONNX на CPU&lt;br&gt;MiniLM-L12, 384 измерения&lt;br&gt;«документ. раздел. текст»" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#00796B;strokeColor=#00796B;fontColor=white;fontFamily=Calibri;fontSize=14;" vertex="1" parent="1"><mxGeometry x="835" y="145" width="210" height="130" as="geometry"/></mxCell><mxCell id="rag-pgv" value="&lt;b&gt;PostgreSQL 17 + pgvector&lt;/b&gt;&lt;br&gt;таблицы documents, chunks&lt;br&gt;HNSW (m=16, ef_c=64)&lt;br&gt;GIN по tsvector(&amp;#x27;russian&amp;#x27;)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#1C2541;strokeColor=#1C2541;fontColor=white;fontFamily=Calibri;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1085" y="145" width="215" height="130" as="geometry"/></mxCell><mxCell id="rag-eval" value="&lt;b&gt;Оценка поиска&lt;/b&gt;&lt;br&gt;golden.json: 25 вопросов&lt;br&gt;Recall@1/3/5, MRR@5&lt;br&gt;vector, fulltext, hybrid" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFB300;strokeColor=#FFB300;fontColor=#2B2100;fontFamily=Calibri;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1340" y="145" width="225" height="130" as="geometry"/></mxCell><mxCell id="rag-user" value="&lt;b&gt;Сотрудник&lt;/b&gt;&lt;br&gt;«сколько суточных&lt;br&gt;в командировке?»" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#546E7A;strokeColor=#546E7A;fontColor=white;fontFamily=Calibri;fontSize=14;" vertex="1" parent="1"><mxGeometry x="105" y="470" width="200" height="130" as="geometry"/></mxCell><mxCell id="rag-qemb" value="&lt;b&gt;Эмбеддинг вопроса&lt;/b&gt;&lt;br&gt;та же модель,&lt;br&gt;что и для чанков" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#3949AB;strokeColor=#3949AB;fontColor=white;fontFamily=Calibri;fontSize=14;" vertex="1" parent="1"><mxGeometry x="345" y="470" width="205" height="130" as="geometry"/></mxCell><mxCell id="rag-srch" value="&lt;b&gt;4. &lt;/b&gt;&lt;b&gt;Гибридный поиск&lt;/b&gt;&lt;br&gt;vector top-20 (HNSW)&lt;br&gt;fulltext top-20 (ts_rank)&lt;br&gt;RRF, берём top-4" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#3949AB;strokeColor=#3949AB;fontColor=white;fontFamily=Calibri;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590" y="470" width="205" height="130" as="geometry"/></mxCell><mxCell id="rag-prm" value="&lt;b&gt;5. &lt;/b&gt;&lt;b&gt;Сборка промпта&lt;/b&gt;&lt;br&gt;инструкция и источники [N]&lt;br&gt;с документом и пунктом,&lt;br&gt;сам вопрос" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#3949AB;strokeColor=#3949AB;fontColor=white;fontFamily=Calibri;fontSize=14;" vertex="1" parent="1"><mxGeometry x="835" y="470" width="210" height="130" as="geometry"/></mxCell><mxCell id="rag-llm" value="&lt;b&gt;LLM&lt;/b&gt;&lt;br&gt;в стенде не запускается,&lt;br&gt;зона ML-команды" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#78909C;fontColor=#455A64;fontFamily=Calibri;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="1085" y="470" width="215" height="130" as="geometry"/></mxCell><mxCell id="rag-ans" value="&lt;b&gt;Ответ со ссылками&lt;/b&gt;&lt;br&gt;«700 ₽ в сутки [1]»&lt;br&gt;Регламент командировок, п. 2" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#546E7A;strokeColor=#546E7A;fontColor=white;fontFamily=Calibri;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1340" y="470" width="225" height="130" as="geometry"/></mxCell><mxCell id="rag-e0" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=1.5;fontFamily=Calibri;fontSize=13;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="rag-src" target="rag-ing"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rag-e1" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=1.5;fontFamily=Calibri;fontSize=13;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="rag-ing" target="rag-chk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rag-e2" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=1.5;fontFamily=Calibri;fontSize=13;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="rag-chk" target="rag-emb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rag-e3" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=1.5;fontFamily=Calibri;fontSize=13;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="rag-emb" target="rag-pgv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rag-e4" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=1.5;fontFamily=Calibri;fontSize=13;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="rag-pgv" target="rag-eval"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rag-e5" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=1.5;fontFamily=Calibri;fontSize=13;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="rag-user" target="rag-qemb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rag-e6" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=1.5;fontFamily=Calibri;fontSize=13;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="rag-qemb" target="rag-srch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rag-e7" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=1.5;fontFamily=Calibri;fontSize=13;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="rag-srch" target="rag-prm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rag-e8" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#78909C;strokeWidth=1.5;fontFamily=Calibri;fontSize=13;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="rag-prm" target="rag-llm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rag-e9" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#78909C;strokeWidth=1.5;fontFamily=Calibri;fontSize=13;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="rag-llm" target="rag-ans"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rag-e10" value="ближайшие векторы и совпадения по словам" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=1.5;fontFamily=Calibri;fontSize=13;exitX=0.300;exitY=1.000;exitDx=0;exitDy=0;entryX=0.300;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="rag-pgv" target="rag-srch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="318"/><mxPoint x="652" y="318"/></Array></mxGeometry></mxCell><mxCell id="rag-e11" value="подбор k, весов RRF, ef_search" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#78909C;strokeWidth=1.5;fontFamily=Calibri;fontSize=13;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.750;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="rag-eval" target="rag-srch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1452" y="428"/><mxPoint x="744" y="428"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>