<mxfile host="drawio"><diagram name="RAG-пайплайн" id="rag-main"><mxGraphModel dx="1580" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rg3" value="&lt;b&gt;Вариант 3. RAG по регламентам: от PDF/DOCX до ответа со ссылками (pgvector, гибридный поиск)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="30" as="geometry"/></mxCell><mxCell id="rg4" value="ОФЛАЙН - подготовка знаний (зона data engineer), запуск по расписанию / по событию «документ изменён»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3faf1;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1560" height="200" as="geometry"/></mxCell><mxCell id="rg5" value="ОНЛАЙН - запрос сотрудника" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="1560" height="250" as="geometry"/></mxCell><mxCell id="rg6" value="&lt;b&gt;Источники&lt;/b&gt;&lt;br&gt;СЭД / файловый сервер&lt;br&gt;PDF, DOCX (тысячи регламентов)" style="shape=document;boundedLbl=1;size=0.15;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="200" height="85" as="geometry"/></mxCell><mxCell id="rg7" value="&lt;b&gt;1. Ingestion&lt;/b&gt;&lt;br&gt;pypdf / python-docx&lt;br&gt;очистка колонтитулов&lt;br&gt;sha256 → только изменённые" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="115" width="210" height="95" as="geometry"/></mxCell><mxCell id="rg8" value="&lt;b&gt;2. Chunking&lt;/b&gt;&lt;br&gt;по разделам «N. Заголовок»&lt;br&gt;≤ 400 символов,&lt;br&gt;перекрытие 1 предложение&lt;br&gt;+ метаданные (док, раздел)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="210" height="105" as="geometry"/></mxCell><mxCell id="rg9" value="&lt;b&gt;3. Embedding&lt;/b&gt;&lt;br&gt;fastembed (ONNX, CPU)&lt;br&gt;multilingual MiniLM-L12, 384d&lt;br&gt;текст = «документ. раздел. чанк»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="220" height="105" as="geometry"/></mxCell><mxCell id="rg10" value="&lt;b&gt;pgvector&lt;/b&gt; (PostgreSQL 17)&lt;br&gt;documents + chunks&lt;br&gt;HNSW (m=16, ef_c=64) - вектор&lt;br&gt;GIN (tsvector russian) - текст" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="105" width="240" height="115" as="geometry"/></mxCell><mxCell id="rg11" value="&lt;b&gt;Оценка качества&lt;/b&gt;&lt;br&gt;golden.json: 25 вопросов&lt;br&gt;Recall@1/3/5, MRR@5&lt;br&gt;vector vs FTS vs hybrid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="105" width="190" height="115" as="geometry"/></mxCell><mxCell id="rg12" value="&lt;b&gt;Сотрудник&lt;/b&gt;&lt;br&gt;«сколько суточных&lt;br&gt;в командировке?»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="200" height="80" as="geometry"/></mxCell><mxCell id="rg13" value="Эмбеддинг вопроса&lt;br&gt;(та же модель, что и&lt;br&gt;для чанков!)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="470" width="210" height="80" as="geometry"/></mxCell><mxCell id="rg14" value="&lt;b&gt;4. Поиск&lt;/b&gt;&lt;br&gt;vector top-20 (cosine, HNSW)&lt;br&gt;+ fulltext top-20 (ts_rank)&lt;br&gt;→ RRF → top-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="460" width="210" height="100" as="geometry"/></mxCell><mxCell id="rg15" value="&lt;b&gt;5. Генерация (подготовка)&lt;/b&gt;&lt;br&gt;промпт = инструкция&lt;br&gt;+ источники [N] с разделом&lt;br&gt;+ вопрос" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="460" width="220" height="100" as="geometry"/></mxCell><mxCell id="rg16" value="&lt;b&gt;LLM&lt;/b&gt;&lt;br&gt;(вне зоны DE: выбор модели,&lt;br&gt;промпт-инжиниринг - ML/AI)" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="460" width="240" height="100" as="geometry"/></mxCell><mxCell id="rg17" value="&lt;b&gt;Ответ со ссылками&lt;/b&gt;&lt;br&gt;«700 ₽ в сутки [1]&lt;br&gt;(Регламент командировок, п.2)»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="460" width="190" height="100" as="geometry"/></mxCell><mxCell id="rg18" value="файлы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rg6" target="rg7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rg19" value="чистый текст&lt;br&gt;по разделам" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rg7" target="rg8"><m